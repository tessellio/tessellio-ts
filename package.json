{
  "name": "@tessellio/ts",
  "version": "0.1.0",
  "description": "Tessellio: a screen codec that paints a surface as independently-placed tiles of cells, chained against a reference so a lost update heals. The browser-side implementation.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./op": "./src/screen-op.ts",
    "./frame": "./src/screen-frame.ts",
    "./canvas": "./src/screen-canvas.ts",
    "./stream": "./src/screen-stream.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.0"
  },
  "dependencies": {
    "@tessellio/proto": "file:../tessellio-proto"
  }
}
